# TCP BBR + FQ (default BBR)
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_NET_SCH_FQ=y

# tc/BPF ingress qdisc (clsact) — нужен sing-box eBPF inbound,
# а также tcpdump/tc-фильтрам. select'ит NET_INGRESS + NET_EGRESS.
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_CLS_MATCHALL=y
# CONFIG_BPF_STREAM_PARSER is not set
# ^ не включать: тянет net/core/skmsg.c, который в этом CAF-дереве
#   не компилируется (sk_psock_from_strp используется до определения).
#   Для tc/BPF-clsact не нужен (только для sockmap/strparser).

# ZRAM ZSTD
CONFIG_CRYPTO_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y

# MGLRU: promote mapped executable file pages after first usage
# CONFIG_LRU_GEN_EXEC_PROMOTE is not set

# Baseband Guard (protect critical partitions from writes)
CONFIG_BBG=y
# CONFIG_BBG_BLOCK_BOOT is not set
# CONFIG_BBG_BLOCK_RECOVERY is not set

# Hardening (safe, <1% perf impact)
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_DEVFREQ_MSM_GPU_BOOST_FREQ=430000000

# Kprofiles auto (FB notifier)
CONFIG_AUTO_KPROFILES_FB=y
# CONFIG_AUTO_KPROFILES_NONE is not set

# Reduce attack surface
# CONFIG_IP_SCTP is not set

# Reduce attack surface
# CONFIG_IP_SCTP is not set


